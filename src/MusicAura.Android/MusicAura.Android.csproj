<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>MusicAura.Droid</RootNamespace>
    <AssemblyName>MusicAura</AssemblyName>
    <ApplicationId>com.musicaura.app</ApplicationId>
    <ApplicationTitle>Music Aura</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <!-- Ship arm64 for modern Samsung phones; x86_64 for the emulator. -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <TrimMode>partial</TrimMode>
    <AndroidLinkTool>r8</AndroidLinkTool>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicAura.Core\MusicAura.Core.csproj" />
  </ItemGroup>

</Project>
